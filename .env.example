APP_ENV=development
APP_PORT=8088
APP_PUBLIC_URL=https://linkundang.web.id
DATABASE_URL=postgres://undangan:undangan@localhost:5439/undangan?sslmode=disable
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://linkundang.web.id

# AI Image Generation
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001
NVIDIA_API_KEY=
NVIDIA_IMAGE_ENDPOINT=https://ai.api.nvidia.com/v1/genai/stabilityai/stable-diffusion-xl
GENERATED_ASSET_DIR=./storage/uploads

# PostgreSQL
POSTGRES_USER=undangan_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=undangan

# Midtrans Payment Gateway
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_WEBHOOK_SECRET=
MIDTRANS_CALLBACK_FINISH=https://linkundang.web.id/dashboard

# Email (Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=LinkUndang <noreply@linkundang.web.id>
